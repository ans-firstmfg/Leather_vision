{% liquid
assign ar_product = product | default: block.settings.product
assign allowed_ids = block.settings.variant_ids | remove: ' ' | split: ','
assign mapped_count = 0
if ar_product != blank and block.settings.garment != blank and ar_product.requires_selling_plan == false
for variant in ar_product.variants
assign variant_key = variant.id | append: ''
if allowed_ids contains variant_key
assign mapped_count = mapped_count | plus: 1
endif
endfor
endif
%}
{% assign demo = false %}
{% if mapped_count == 0 and block.settings.sample_preview %}{% assign demo = true %}{% endif %}
{% assign sample_names = 'Black cafe racer|Flame-detail jacket|Raider motorcycle jacket|3D white mesh (experimental)' | split: '|' %}
{% assign sample_ids = '1|6|7|4' | split: '|' %}
{% assign sample_fits = 'cafe|flame|raider|model3d' | split: '|' %}
{% assign sample_files = 'ar-sample-cafe.png|ar-sample-flame.png|ar-sample-raider.png|white-mesh.gltf.json' | split: '|' %}
{% if mapped_count > 0 or demo %}
{% capture ar_data %}
{"id":{{ ar_product.id | append: '' | json }},"title":{{ ar_product.title | json }},"url":{{ ar_product.url | json }},"variants":[
{% assign emitted = false %}
{% for variant in ar_product.variants %}
{% assign variant_key = variant.id | append: '' %}
{% if allowed_ids contains variant_key %}
{% if emitted %},{% endif %}
{"id":{{ variant_key | json }},"title":{{ variant.title | json }},"price":{{ variant.price | money_with_currency | json }},"available":{{ variant.available | json }},"fit":{{ block.settings.garment_kind | default: 'vest' | json }},"asset":{{ block.settings.garment | image_url: width: 1200 | json }}}
{% assign emitted = true %}
{% endif %}
{% endfor %}]}
{% endcapture %}
{% if demo %}
{% capture ar_data %}{"id":"sample","title":{{ 'live_ar.demo' | t | json }},"url":"","demo":true,"variants":[{% for name in sample_names %}{% unless forloop.first %},{% endunless %}{"id":"{{ sample_ids[forloop.index0] }}","title":{{ name | json }},"price":"","available":true,"fit":{{ sample_fits[forloop.index0] | json }},"asset":{{ sample_files[forloop.index0] | asset_url | json }}}{% endfor %}]}{% endcapture %}
{% endif %}
{% capture ar_copy %}
{"camera_error":{{ 'live_ar.camera_error' | t | json }},"module_error":{{ 'live_ar.module_error' | t | json }},"model_error":{{ 'live_ar.model_error' | t | json }},"frame_error":{{ 'live_ar.frame_error' | t | json }},"permission":{{ 'live_ar.permission' | t | json }},"starting":{{ 'live_ar.permission' | t | json }},"loading":{{ 'live_ar.loading' | t | json }},"body_missing":{{ 'live_ar.body_missing' | t | json }},"model_preview":{{ 'live_ar.model_preview' | t | json }},"tracking":{{ 'live_ar.tracking' | t | json }},"arms_missing":{{ 'live_ar.arms_missing' | t | json }},"lost":{{ 'live_ar.body_missing' | t | json }},"denied":{{ 'live_ar.denied' | t | json }},"unsupported":{{ 'live_ar.unsupported' | t | json }},"runtime_error":{{ 'live_ar.runtime_error' | t | json }},"asset_error":{{ 'live_ar.asset_error' | t | json }},"paused":{{ 'live_ar.paused' | t | json }},"variant_unavailable":{{ 'live_ar.variant_unavailable' | t | json }},"cart_error":{{ 'live_ar.cart_error' | t | json }},"adding":{{ 'live_ar.adding' | t | json }},"added":{{ 'live_ar.added' | t | json }}}
{% endcapture %}
<first-mfg-live-ar class="fm-ar" data-product="{{ ar_data | escape }}" data-copy="{{ ar_copy | escape }}" data-model-module="{{ 'live-ar-3d.js' | asset_url }}" data-engine="{{ 'leather-vision-ar-engine.js' | asset_url }}" data-handoff-module="{{ 'live-ar-handoff.js' | asset_url }}" data-handoff-id="{{ block.id | escape }}" data-handoff-base="{{ request.path | prepend: request.origin | escape }}" data-cart-add-url="{{ routes.cart_add_url | append: '.js' }}" {{ block.shopify_attributes }}>
<div class="fm-ar__showcase"><div class="fm-ar__intro"><span class="fm-ar__eyebrow">{{ shop.name | escape }}</span><h2>{{ 'live_ar.launch' | t }}</h2><p>{% if demo %}{{ 'live_ar.demo' | t }}{% else %}{{ ar_product.title | escape }}{% endif %}</p>
<div class="fm-ar__row"><button type="button" class="fm-ar__button" data-ar-open>{{ 'live_ar.this_camera' | t }}</button><button type="button" class="fm-ar__button fm-ar__button--quiet" data-ar-mobile>{{ 'live_ar.phone_camera' | t }}</button></div><p data-ar-mobile-error role="status" hidden>{{ 'live_ar.qr_error' | t }}</p><p class="fm-ar__note">{{ 'live_ar.privacy' | t }}</p></div>
{% if demo %}<div class="fm-ar__samples">{% for name in sample_names %}<button type="button" class="fm-ar__sample" data-ar-sample="{{ sample_ids[forloop.index0] }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">{% if sample_fits[forloop.index0] == 'model3d' %}<span class="fm-ar__model-icon" aria-hidden="true">3D</span>{% else %}<img src="{{ sample_files[forloop.index0] | asset_url }}" alt="{{ name | escape }}" width="96" height="120" loading="lazy">{% endif %}<span>{{ name | escape }}</span></button>{% endfor %}</div>{% else %}{{ block.settings.garment | image_url: width: 600 | image_tag: class: 'fm-ar__product', loading: 'lazy' }}{% endif %}</div>
<section class="fm-ar__mobile" data-ar-mobile-panel aria-labelledby="ar-mobile-title-{{ block.id }}" tabindex="-1" hidden>
<div><h3 id="ar-mobile-title-{{ block.id }}">{{ 'live_ar.phone_camera' | t }}</h3><p>{{ 'live_ar.qr_instructions' | t }}</p><p>{{ 'live_ar.qr_privacy' | t }}</p><a data-ar-mobile-link target="_blank" rel="noopener" hidden>{{ 'live_ar.open_mobile_link' | t }}</a><p data-ar-mobile-unavailable role="status" hidden>{{ 'live_ar.qr_unavailable' | t }}</p><button type="button" class="fm-ar__button fm-ar__button--quiet" data-ar-mobile-close>{{ 'live_ar.qr_close' | t }}</button></div>
<div class="fm-ar__qr" data-ar-qr role="img" aria-label="{{ 'live_ar.qr_alt' | t | escape }}" hidden></div>
</section>
<dialog class="fm-ar__dialog" aria-label="{{ 'live_ar.launch' | t | escape }}">
<header class="fm-ar__header">
<strong>{{ shop.name | escape }}</strong>
<button type="button" class="fm-ar__button fm-ar__button--quiet" data-ar-close>{{ 'live_ar.close' | t }}</button>
</header>
<div class="fm-ar__stage">
<div class="fm-ar__feed"><video muted autoplay playsinline aria-label="{{ 'live_ar.launch' | t | escape }}"></video><canvas aria-hidden="true"></canvas></div>
<p class="fm-ar__status" data-ar-status role="status">{{ 'live_ar.permission' | t }}</p>
</div>
<div class="fm-ar__controls">
<h2>{% if demo %}{{ 'live_ar.demo' | t }}{% else %}{{ ar_product.title | escape }}{% endif %}</h2>
<p>{{ 'live_ar.privacy' | t }}</p>

<div class="fm-ar__row">
<button type="button" class="fm-ar__button" data-ar-start>{{ 'live_ar.start' | t }}</button>
<button type="button" class="fm-ar__button fm-ar__button--quiet" data-ar-switch disabled>{{ 'live_ar.switch' | t }}</button>
</div>
<label for="ar-variant-{{ block.id }}">{% if demo %}{{ 'live_ar.launch' | t }}{% else %}{{ 'live_ar.variant' | t }}{% endif %}</label>
<select id="ar-variant-{{ block.id }}">{% if demo %}{% for name in sample_names %}<option value="{{ sample_ids[forloop.index0] }}">{{ name | escape }}</option>{% endfor %}{% else %}
{% for variant in ar_product.variants %}
{% assign variant_key = variant.id | append: '' %}
{% if allowed_ids contains variant_key %}
<option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %} {% if variant == ar_product.selected_or_first_available_variant %}selected{% endif %}>{{ variant.title | escape }} · {{ variant.price | money_with_currency }}{% unless variant.available %} — {{ 'live_ar.sold_out' | t }}{% endunless %}</option>
{% endif %}
{% endfor %}
{% endif %}</select>
<div class="fm-ar__row">
{% unless demo %}<button type="button" class="fm-ar__button" data-ar-cart>{{ 'live_ar.add_cart' | t }}</button>
<a href="{{ routes.cart_url }}">{{ 'live_ar.view_cart' | t }}</a>{% endunless %}
{% if block.settings.photo_url != blank %}<a href="{{ block.settings.photo_url }}">{{ 'live_ar.photo' | t }}</a>{% endif %}
</div>
<p data-ar-cart-status role="status"></p>
</div>
</dialog>
<noscript><p>{{ 'live_ar.unsupported' | t }}</p></noscript>
</first-mfg-live-ar>
{% elsif request.design_mode %}
<p {{ block.shopify_attributes }}>{{ 'live_ar.setup' | t }}</p>
{% endif %}
{% schema %}
{
"name": "t:live_ar.name",
"target": "section",
"stylesheet": "leather-vision-ar.css",
"javascript": "leather-vision-ar.js",
"settings": [{"type":"select","id":"garment_kind","label":"t:live_ar.garment_kind","default":"vest","options":[{"value":"vest","label":"t:live_ar.vest"},{"value":"jacket","label":"t:live_ar.jacket"}]},
{"type":"checkbox","id":"sample_preview","default":true,"label":"t:live_ar.sample_preview","info":"t:live_ar.sample_info"},
{"type":"product","id":"product","label":"t:live_ar.product","info":"t:live_ar.product_info"},
{"type":"image_picker","id":"garment","label":"t:live_ar.garment","info":"t:live_ar.garment_info"},
{"type":"text","id":"variant_ids","label":"t:live_ar.variant_ids","info":"t:live_ar.variant_ids_info"},
{"type":"url","id":"photo_url","label":"t:live_ar.photo_url"}
]
}
{% endschema %}
