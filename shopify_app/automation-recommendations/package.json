    "@react-router/serve": "7.18.2",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/shopify-app-react-router": "^1.2.1",
    "@shopify/shopify-app-session-storage-prisma": "^9.0.0",
    "isbot": "^5.1.31",
    "prisma": "^6.16.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "7.18.2",
    "vite-tsconfig-paths": "^5.1.4"
