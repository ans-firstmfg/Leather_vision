SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-app-host.example
SCOPES=write_app_proxy
DATABASE_URL=file:dev.sqlite

# OpenAI image editing.
IMAGE_PROVIDER=openai
# For free local pipeline testing, set IMAGE_PROVIDER=mock (development only).
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# Persistent storage shared by the web application and its worker.
GENERATION_DATA_DIR=.data
GENERATION_CONCURRENCY=2
GENERATION_ACTIVE_PER_SHOP=3
GENERATION_DAILY_IMAGES_PER_SHOP=50
GENERATION_DAILY_IMAGES_PER_ACTOR=12
GENERATION_RETENTION_DAYS=30

# Proxies between Shopify and this app that append to X-Forwarded-For (tunnel/load balancer).
TRUSTED_PROXY_HOPS=1
