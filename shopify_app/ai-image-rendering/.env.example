SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-app-host.example
SCOPES=write_app_proxy
DATABASE_URL=file:dev.sqlite

# OpenAI image editing.
IMAGE_PROVIDER=openai
# For free local pipeline testing, set IMAGE_PROVIDER=mock (development only).
# For customer-account image generation, set IMAGE_PROVIDER=puter. No Google API key is needed.
# For server-side Cloudflare testing, set IMAGE_PROVIDER=cloudflare after configuring access.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
# Small test output only; accepts 256 or 512. The account's free allowance is shared.
CLOUDFLARE_IMAGE_SIZE=512
PUTER_IMAGE_MODEL=gemini-3.1-flash-image
PUTER_IMAGE_QUALITY=512
# true returns sample images without applying instructions; false requests real generation.
PUTER_TEST_MODE=false
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# Persistent storage shared by the web application and its worker.
GENERATION_DATA_DIR=.data
GENERATION_CONCURRENCY=2
GENERATION_ACTIVE_PER_SHOP=3
GENERATION_DAILY_IMAGES_PER_SHOP=50
GENERATION_DAILY_IMAGES_PER_ACTOR=12
GENERATION_RETENTION_DAYS=30

# Proxies between Shopify and this app that append to X-Forwarded-For (tunnel/load balancer).
TRUSTED_PROXY_HOPS=1
