{% comment %}
  Leather Vision storefront block.
  Talks to the app only via App Proxy (/apps/leather-vision/...).
{% endcomment %}

{% capture lv_copy %}
{"submit": {{ "leather_vision.submit" | t | json }},
"generating": {{ "leather_vision.generating" | t | json }},
"error_generic": {{ "leather_vision.error_generic" | t | json }},
"error_connection": {{ "leather_vision.error_connection" | t | json }},
"error_size": {{ "leather_vision.error_size" | t | json }},
"error_details": {{ "leather_vision.error_details" | t | json }},
"error_timeout": {{ "leather_vision.error_timeout" | t | json }},
"error_cart": {{ "leather_vision.error_cart" | t | json }},
"uploading": {{ "leather_vision.uploading" | t | json }},
"demo_done": {{ "leather_vision.demo_done" | t | json }},
"reconnecting": {{ "leather_vision.reconnecting" | t | json }},
"upload_preview": {{ "leather_vision.upload_preview" | t | json }},
"variation": {{ "leather_vision.variation" | t | json }},
"select": {{ "leather_vision.select" | t | json }},
"selected": {{ "leather_vision.selected" | t | json }},
"adding": {{ "leather_vision.adding" | t | json }},
"puter_connecting": {{ "leather_vision.puter_connecting" | t | json }},
"puter_connected": {{ "leather_vision.puter_connected" | t | json }},
"puter_connect_required": {{ "leather_vision.puter_connect_required" | t | json }},
"puter_interrupted": {{ "leather_vision.puter_interrupted" | t | json }},
"puter_error": {{ "leather_vision.puter_error" | t | json }},
"puter_error_funds": {{ "leather_vision.puter_error_funds" | t | json }},
"puter_error_moderation": {{ "leather_vision.puter_error_moderation" | t | json }}}
{% endcapture %}

<leather-vision
  class="lv"
  id="LeatherVision-{{ block.id }}"
  data-proxy-path="{{ block.settings.proxy_path | default: '/apps/leather-vision' | escape }}"
  data-block-id="{{ block.id }}"
  data-lv-copy="{{ lv_copy | escape }}"
  data-cart-add-url="{{ routes.cart_add_url | append: '.js' | escape }}"
  data-cart-url="{{ routes.cart_url | escape }}"
  data-puter-script="{{ 'leather-vision-puter.js' | asset_url | escape }}"
  data-flow-script="{{ 'leather-vision-flow.js' | asset_url | escape }}"
  {{ block.shopify_attributes }}
>
  <header class="lv__header">
    {% assign lv_heading = block.settings.heading | default: 'First MFG Co' %}
    {% if lv_heading == 'Leather Vision' %}
      {% assign lv_heading = 'First MFG Co' %}
    {% endif %}
    <h2 class="lv__title">{{ lv_heading | escape }}</h2>
    <p class="lv__subtitle">{{ 'leather_vision.subtitle' | t }}</p>
  </header>

  <div class="lv__workspace">
  <form class="lv__form" data-lv-form novalidate>
  <leather-vision-flow class="lv__flow">
  <section class="lv__flow-step" data-flow-step="1" >
    <h3 class="lv__flow-heading"><span class="lv__section-header">
      <span class="lv__flow-number" aria-hidden="true">1</span><span class="lv__flow-title"><span id="lv-flow-title-1-{{ block.id }}">{{ 'leather_vision.flow_category' | t }}</span><small data-flow-summary></small></span>
    </span></h3>
    <div class="lv__flow-panel" id="lv-flow-1-{{ block.id }}" data-flow-panel ><fieldset class="lv__choices" aria-labelledby="lv-flow-title-1-{{ block.id }}"><label class="lv__choice ">
      <input type="radio" name="leather" value="atlas-full-grain" required data-lv-field data-label="{{ 'leather_vision.flow_categories.atlas-full-grain' | t | escape }}">
      <span class="lv__choice-tile"><img src="{{ 'lv-leather-atlas-full-grain.jpg' | asset_url }}" alt="" width="320" height="200" loading="lazy"><span class="lv__choice-label">{{ 'leather_vision.flow_categories.atlas-full-grain' | t }}</span><span class="lv__choice-check" aria-hidden="true">✓</span></span>
    </label>
<label class="lv__choice ">
      <input type="radio" name="leather" value="buffalo-pebble" required data-lv-field data-label="{{ 'leather_vision.flow_categories.buffalo-pebble' | t | escape }}">
      <span class="lv__choice-tile"><img src="{{ 'lv-leather-buffalo-pebble.jpg' | asset_url }}" alt="" width="320" height="200" loading="lazy"><span class="lv__choice-label">{{ 'leather_vision.flow_categories.buffalo-pebble' | t }}</span><span class="lv__choice-check" aria-hidden="true">✓</span></span>
    </label>
<label class="lv__choice ">
      <input type="radio" name="leather" value="sassari-embossed" required data-lv-field data-label="{{ 'leather_vision.flow_categories.sassari-embossed' | t | escape }}">
      <span class="lv__choice-tile"><img src="{{ 'lv-leather-sassari-embossed.jpg' | asset_url }}" alt="" width="320" height="200" loading="lazy"><span class="lv__choice-label">{{ 'leather_vision.flow_categories.sassari-embossed' | t }}</span><span class="lv__choice-check" aria-hidden="true">✓</span></span>
    </label>
<label class="lv__choice ">
      <input type="radio" name="leather" value="stardust-glitter-cow" required data-lv-field data-label="{{ 'leather_vision.flow_categories.stardust-glitter-cow' | t | escape }}">
      <span class="lv__choice-tile"><img src="{{ 'lv-leather-stardust-glitter-cow.jpg' | asset_url }}" alt="" width="320" height="200" loading="lazy"><span class="lv__choice-label">{{ 'leather_vision.flow_categories.stardust-glitter-cow' | t }}</span><span class="lv__choice-check" aria-hidden="true">✓</span></span>
    </label>
<label class="lv__choice ">
      <input type="radio" name="leather" value="tennessee-italian" required data-lv-field data-label="{{ 'leather_vision.flow_categories.tennessee-italian' | t | escape }}">
      <span class="lv__choice-tile"><img src="{{ 'lv-leather-tennessee-italian.jpg' | asset_url }}" alt="" width="320" height="200" loading="lazy"><span class="lv__choice-label">{{ 'leather_vision.flow_categories.tennessee-italian' | t }}</span><span class="lv__choice-check" aria-hidden="true">✓</span></span>
    </label></fieldset></div>
  </section>
  <section class="lv__flow-step" data-flow-step="2">
    <h3 class="lv__flow-heading"><span class="lv__section-header">
      <span class="lv__flow-number" aria-hidden="true">2</span><span class="lv__flow-title"><span id="lv-flow-title-2-{{ block.id }}">{{ 'leather_vision.flow_color' | t }}</span><small data-flow-summary></small></span>
    </span></h3>
    <div class="lv__flow-panel" id="lv-flow-2-{{ block.id }}" data-flow-panel><fieldset class="lv__choices lv__choices--colors" aria-labelledby="lv-flow-title-2-{{ block.id }}"><label class="lv__choice lv__choice--color">
      <input type="radio" name="color" value="Baby Blue" required data-lv-field data-label="{{ 'leather_vision.flow_colors.baby-blue' | t | escape }}">
      <span class="lv__choice-tile"><img src="{{ 'lv-color-baby-blue.jpg' | asset_url }}" alt="" width="96" height="96" loading="lazy"><span class="lv__choice-label">{{ 'leather_vision.flow_colors.baby-blue' | t }}</span><span class="lv__choice-check" aria-hidden="true">✓</span></span>
    </label>
<label class="lv__choice lv__choice--color">
      <input type="radio" name="color" value="Beige" required data-lv-field data-label="{{ 'leather_vision.flow_colors.beige' | t | escape }}">
      <span class="lv__choice-tile"><img src="{{ 'lv-color-beige.jpg' | asset_url }}" alt="" width="96" height="96" loading="lazy"><span class="lv__choice-label">{{ 'leather_vision.flow_colors.beige' | t }}</span><span class="lv__choice-check" aria-hidden="true">✓</span></span>
    </label>
<label class="lv__choice lv__choice--color">
      <input type="radio" name="color" value="Black" required data-lv-field data-label="{{ 'leather_vision.flow_colors.black' | t | escape }}">
      <span class="lv__choice-tile"><img src="{{ 'lv-color-black.jpg' | asset_url }}" alt="" width="96" height="96" loading="lazy"><span class="lv__choice-label">{{ 'leather_vision.flow_colors.black' | t }}</span><span class="lv__choice-check" aria-hidden="true">✓</span></span>
    </label>
<label class="lv__choice lv__choice--color">
      <input type="radio" name="color" value="Bone" required data-lv-field data-label="{{ 'leather_vision.flow_colors.bone' | t | escape }}">
      <span class="lv__choice-tile"><img src="{{ 'lv-color-bone.jpg' | asset_url }}" alt="" width="96" height="96" loading="lazy"><span class="lv__choice-label">{{ 'leather_vision.flow_colors.bone' | t }}</span><span class="lv__choice-check" aria-hidden="true">✓</span></span>
    </label>
<label class="lv__choice lv__choice--color">
      <input type="radio" name="color" value="Camel" required data-lv-field data-label="{{ 'leather_vision.flow_colors.camel' | t | escape }}">
      <span class="lv__choice-tile"><img src="{{ 'lv-color-camel.jpg' | asset_url }}" alt="" width="96" height="96" loading="lazy"><span class="lv__choice-label">{{ 'leather_vision.flow_colors.camel' | t }}</span><span class="lv__choice-check" aria-hidden="true">✓</span></span>
    </label>
<label class="lv__choice lv__choice--color">
      <input type="radio" name="color" value="Chocolate" required data-lv-field data-label="{{ 'leather_vision.flow_colors.chocolate' | t | escape }}">
      <span class="lv__choice-tile"><img src="{{ 'lv-color-chocolate.jpg' | asset_url }}" alt="" width="96" height="96" loading="lazy"><span class="lv__choice-label">{{ 'leather_vision.flow_colors.chocolate' | t }}</span><span class="lv__choice-check" aria-hidden="true">✓</span></span>
    </label>
<label class="lv__choice lv__choice--color">
      <input type="radio" name="color" value="Coral" required data-lv-field data-label="{{ 'leather_vision.flow_colors.coral' | t | escape }}">
      <span class="lv__choice-tile"><img src="{{ 'lv-color-coral.jpg' | asset_url }}" alt="" width="96" height="96" loading="lazy"><span class="lv__choice-label">{{ 'leather_vision.flow_colors.coral' | t }}</span><span class="lv__choice-check" aria-hidden="true">✓</span></span>
    </label>
<label class="lv__choice lv__choice--color">
      <input type="radio" name="color" value="Electric" required data-lv-field data-label="{{ 'leather_vision.flow_colors.electric' | t | escape }}">
      <span class="lv__choice-tile"><img src="{{ 'lv-color-electric.jpg' | asset_url }}" alt="" width="96" height="96" loading="lazy"><span class="lv__choice-label">{{ 'leather_vision.flow_colors.electric' | t }}</span><span class="lv__choice-check" aria-hidden="true">✓</span></span>
    </label>
<label class="lv__choice lv__choice--color">
      <input type="radio" name="color" value="Gray" required data-lv-field data-label="{{ 'leather_vision.flow_colors.gray' | t | escape }}">
      <span class="lv__choice-tile"><img src="{{ 'lv-color-gray.jpg' | asset_url }}" alt="" width="96" height="96" loading="lazy"><span class="lv__choice-label">{{ 'leather_vision.flow_colors.gray' | t }}</span><span class="lv__choice-check" aria-hidden="true">✓</span></span>
    </label>
<label class="lv__choice lv__choice--color">
      <input type="radio" name="color" value="Red" required data-lv-field data-label="{{ 'leather_vision.flow_colors.red' | t | escape }}">
      <span class="lv__choice-tile"><img src="{{ 'lv-color-red.jpg' | asset_url }}" alt="" width="96" height="96" loading="lazy"><span class="lv__choice-label">{{ 'leather_vision.flow_colors.red' | t }}</span><span class="lv__choice-check" aria-hidden="true">✓</span></span>
    </label>
<label class="lv__choice lv__choice--color">
      <input type="radio" name="color" value="Teal" required data-lv-field data-label="{{ 'leather_vision.flow_colors.teal' | t | escape }}">
      <span class="lv__choice-tile"><img src="{{ 'lv-color-teal.jpg' | asset_url }}" alt="" width="96" height="96" loading="lazy"><span class="lv__choice-label">{{ 'leather_vision.flow_colors.teal' | t }}</span><span class="lv__choice-check" aria-hidden="true">✓</span></span>
    </label>
<label class="lv__choice lv__choice--color">
      <input type="radio" name="color" value="White" required data-lv-field data-label="{{ 'leather_vision.flow_colors.white' | t | escape }}">
      <span class="lv__choice-tile"><img src="{{ 'lv-color-white.jpg' | asset_url }}" alt="" width="96" height="96" loading="lazy"><span class="lv__choice-label">{{ 'leather_vision.flow_colors.white' | t }}</span><span class="lv__choice-check" aria-hidden="true">✓</span></span>
    </label></fieldset></div>
  </section>
  <section class="lv__flow-step" data-flow-step="3">
    <h3 class="lv__flow-heading"><span class="lv__section-header">
      <span class="lv__flow-number" aria-hidden="true">3</span><span class="lv__flow-title"><span id="lv-flow-title-3-{{ block.id }}">{{ 'leather_vision.flow_details' | t }}</span><small data-flow-summary></small></span>
    </span></h3>
    <div class="lv__flow-panel" id="lv-flow-3-{{ block.id }}" data-flow-panel>
    <div class="lv__field"><textarea id="lv-instructions-{{ block.id }}" class="lv__input lv__textarea" name="instructions" aria-labelledby="lv-flow-title-3-{{ block.id }}" rows="3" maxlength="500" placeholder="{{ 'leather_vision.instructions_placeholder' | t | escape }}" data-lv-field></textarea></div>
    <div class="lv__or"><span>{{ 'leather_vision.or' | t }}</span></div>
    <div class="lv__field lv__upload">
      <label class="lv__upload-control" for="lv-image-{{ block.id }}">
      <span>{{ 'leather_vision.upload_label' | t }}</span>
      <input
        id="lv-image-{{ block.id }}"
        class="lv__upload-input"
        type="file"
        name="image"
        accept="image/png,image/jpeg,image/webp,.png,.jpg,.jpeg,.jfif,.webp"
        data-lv-image
      >
      </label>
      <div class="lv__preview" data-lv-preview hidden></div>
    </div>

    <input type="hidden" name="variationCount" value="2">
    <div class="lv__actions">
      <button type="submit" class="lv__btn" data-lv-submit>{{ 'leather_vision.submit' | t }}</button>
    </div>
    <p class="lv__hint" data-lv-puter hidden>{{ 'leather_vision.puter_notice' | t }}</p>
    <p class="lv__hint" data-lv-puter-test hidden>{{ 'leather_vision.puter_test_notice' | t }}</p>
</div>
  </section>
  </leather-vision-flow>
  </form>
  <aside class="lv__output" aria-label="{{ 'leather_vision.output_title' | t | escape }}">
    <div class="lv__output-heading">
      <div><h3>{{ 'leather_vision.output_title' | t }}</h3></div>
    </div>
    <p class="lv__error" data-lv-error hidden role="alert"></p>
    <div class="lv__empty" data-lv-empty>
      <div class="lv__empty-canvas" aria-hidden="true">
        <svg viewBox="0 0 80 80" fill="none" class="lv__empty-icon">
          <rect x="12" y="12" width="56" height="56" rx="16" stroke="currentColor" stroke-width="1.5"/>
          <path d="m40 24 4.5 11.5L56 40l-11.5 4.5L40 56l-4.5-11.5L24 40l11.5-4.5L40 24Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
          <path d="M61 15V5M56 10h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <span>{{ 'leather_vision.preview_label' | t }}</span>
      </div>
    </div>
  <p class="lv__status" data-lv-demo hidden role="status">{{ 'leather_vision.demo' | t }}</p>
  <p class="lv__status" data-lv-status hidden role="status" aria-live="polite"></p>


  <div class="lv__results" data-lv-results hidden>
    <div class="lv__variations" data-lv-variations></div>
    {% assign lv_product = block.settings.product %}
    {% if lv_product != blank and lv_product.available and lv_product.requires_selling_plan == false %}
      <div class="lv__field">
        <label class="lv__label" for="lv-variant-{{ block.id }}">{{ lv_product.title | escape }}</label>
        <select id="lv-variant-{{ block.id }}" class="lv__input" data-lv-variant>
          {% for variant in lv_product.variants %}
            {% if variant.available %}
              <option value="{{ variant.id }}">{{ variant.title | escape }} · {{ variant.price | money }}</option>
            {% endif %}
          {% endfor %}
        </select>
      </div>
      <button type="button" class="lv__btn" data-lv-cart disabled>{{ 'leather_vision.add_to_cart' | t }}</button>
    {% endif %}
  </div>
  </aside>
  </div>
</leather-vision>

{% schema %}
{
  "name": "t:name",
  "target": "section",
  "class": "leather-vision-app-block",
  "stylesheet": "leather-vision.css",
  "javascript": "leather-vision.js",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "First MFG Co"
    },
    {
      "type": "product",
      "id": "product",
      "label": "t:settings.product",
      "info": "t:settings.product_info"
    },
    {
      "type": "text",
      "id": "proxy_path",
      "label": "t:settings.proxy_path",
      "info": "t:settings.proxy_path_info",
      "default": "/apps/leather-vision"
    }
  ]
}
{% endschema %}
