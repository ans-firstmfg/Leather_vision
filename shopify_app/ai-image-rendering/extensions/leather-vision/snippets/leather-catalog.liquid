{% doc %}
  Leather article picker generated from catalog/leathers.json.
  Rebuild with node scripts/build-leather-catalog.mjs.
  @param {string} block_id - The app block instance identifier.
{% enddoc %}
<div class="lv__field">
  <label class="lv__label" for="lv-leather-group-{{ block_id }}">{{ 'leather_vision.catalog_group' | t }}</label>
  <select id="lv-leather-group-{{ block_id }}" class="lv__input" data-leather-group>
    <option value="">{{ 'leather_vision.catalog_all' | t }}</option>
    <option value="Cowhide">{{ 'leather_vision.catalog_groups.group-0' | t }}</option>
    <option value="Lambskin">{{ 'leather_vision.catalog_groups.group-1' | t }}</option>
    <option value="Suede &amp; Nubuck">{{ 'leather_vision.catalog_groups.group-2' | t }}</option>
    <option value="Shearling &amp; Fur">{{ 'leather_vision.catalog_groups.group-3' | t }}</option>
    <option value="Hair-On">{{ 'leather_vision.catalog_groups.group-4' | t }}</option>
    <option value="Novelty">{{ 'leather_vision.catalog_groups.group-5' | t }}</option>
    <option value="Vegan">{{ 'leather_vision.catalog_groups.group-6' | t }}</option>
  </select>
</div>
