{% comment %}
  Displays merchant-configured materials with accessible keyboard tabs.
  @example Add Material Builder to a page and configure its material blocks.
{% endcomment %}
{% liquid
  assign section_id = 'material-builder-' | append: section.id
%}

<material-builder-component id="{{ section_id }}" class="material-builder">
  <div class="material-builder__tabs-wrapper">
    <div class="material-builder__tabs" role="tablist" aria-label="{{ 'accessibility.material_tabs' | t | escape }}">
      {% for block in section.blocks %}
        <button
          type="button"
          class="material-builder__tab {% if forloop.first %}is-active{% endif %}"
          id="{{ section_id }}-tab-{{ block.id }}"
          role="tab"
          tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          aria-controls="{{ section_id }}-panel-{{ block.id }}"
          data-tab="{{ block.id }}"
          {{ block.shopify_attributes }}
        >
          {{ block.settings.tab_title | escape }}
        </button>
      {% endfor %}
    </div>
  </div>

  <div class="material-builder__content">
    {% for block in section.blocks %}
      <div
        id="{{ section_id }}-panel-{{ block.id }}"
        class="material-builder__panel {% if forloop.first %}is-active{% endif %}"
        role="tabpanel"
        {% unless forloop.first %}hidden{% endunless %}
        aria-labelledby="{{ section_id }}-tab-{{ block.id }}"
        data-panel="{{ block.id }}"
      >
        <div class="material-builder__text">
          {% if block.settings.heading != blank %}
            <h2 class="material-builder__heading">
              {{ block.settings.heading | escape }}
            </h2>
          {% endif %}

          {% if block.settings.description != blank %}
            <div class="material-builder__description">
              {{ block.settings.description }}
            </div>
          {% endif %}

          {% if block.settings.button_label != blank %}
            <a
              href="{{ block.settings.button_link | default: '#' | escape }}"
              class="material-builder__button"
            >
              {{ block.settings.button_label | escape }}
            </a>
          {% endif %}
        </div>

        <div class="material-builder__image-wrapper">
          {% if block.settings.image != blank %}
            {% assign image_alt = block.settings.image.alt | default: block.settings.heading %}
            {{
              block.settings.image
              | image_url: width: 1600
              | image_tag:
                loading: 'lazy',
                class: 'material-builder__image',
                widths: '400, 600, 800, 1000, 1200, 1600',
                sizes: '(min-width: 990px) 50vw, 100vw',
                alt: image_alt
            }}

          {% else %}
            <div class="material-builder__image-placeholder">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</material-builder-component>

<style>
  #{{ section_id }} {
    display: block;
    --mb-background: {{ section.settings.background_color }};
    --mb-text-color: {{ section.settings.text_color }};
    --mb-accent-color: {{ section.settings.accent_color }};

    background: var(--mb-background);
    color: var(--mb-text-color);
    width: 100%;
  }

  #{{ section_id }} .material-builder__tabs-wrapper {
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
    padding: 0 4%;
  }

  #{{ section_id }} .material-builder__tabs {
    display: flex;
    justify-content: center;
    align-items: stretch;
    gap: 0;
  }

  #{{ section_id }} .material-builder__tab {
    position: relative;

    appearance: none;
    border: 0;
    background: transparent;

    color: color-mix(in srgb, var(--mb-text-color) 62%, transparent);

    font-family: inherit;
    font-size: 15px;
    font-weight: 400;
    letter-spacing: 0.02em;

    padding: 30px 46px 27px;

    cursor: pointer;

    transition:
      color 0.25s ease,
      opacity 0.25s ease;
  }

  #{{ section_id }} .material-builder__tab:hover {
    color: var(--mb-text-color);
  }

  #{{ section_id }} .material-builder__tab.is-active {
    color: var(--mb-text-color);
    font-weight: 500;
  }

  #{{ section_id }} .material-builder__tab.is-active::after {
    content: "";

    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;

    height: 1px;

    background: var(--mb-accent-color);
  }

  #{{ section_id }} .material-builder__content {
    width: 100%;
  }

  #{{ section_id }} .material-builder__panel {
    display: none;

    grid-template-columns: 1fr 1fr;

    min-height: 570px;
  }

  #{{ section_id }} .material-builder__panel[hidden] {
    display: none;
  }

  #{{ section_id }} .material-builder__panel.is-active {
    display: grid;
  }

  #{{ section_id }} .material-builder__text {
    display: flex;
    flex-direction: column;
    justify-content: center;

    padding: 70px 10%;
  }

  #{{ section_id }} .material-builder__heading {
    margin: 0 0 42px;

    color: var(--mb-text-color);

    font-size: clamp(32px, 3vw, 44px);
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  #{{ section_id }} .material-builder__description {
    max-width: 650px;

    color: rgba(255, 255, 255, 0.72);

    font-size: 18px;
    font-weight: 400;
    line-height: 1.8;
  }

  #{{ section_id }} .material-builder__description p {
    margin: 0 0 18px;
  }

  #{{ section_id }} .material-builder__description a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  #{{ section_id }} .material-builder__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    width: fit-content;

    margin-top: 34px;
    padding: 20px 36px;

    border: 1px solid rgba(255, 255, 255, 0.8);

    color: var(--mb-text-color);
    background: transparent;

    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;

    transition:
      background 0.25s ease,
      color 0.25s ease;
  }

  #{{ section_id }} .material-builder__button:hover {
    background: #ffffff;
    color: #111111;
  }

  #{{ section_id }} .material-builder__image-wrapper {
    position: relative;

    min-height: 570px;

    overflow: hidden;
  }

  #{{ section_id }} .material-builder__image {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center;
  }

  #{{ section_id }} .material-builder__image-placeholder {
    width: 100%;
    height: 100%;
    min-height: 570px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #333333;
  }

  #{{ section_id }} .material-builder__image-placeholder svg {
    width: 100%;
    height: 100%;
  }


  /* --------------------------------
     TABLET
  -------------------------------- */

  @media screen and (max-width: 989px) {

    #{{ section_id }} .material-builder__tab {
      padding: 25px 25px 22px;
      font-size: 14px;
    }

    #{{ section_id }} .material-builder__text {
      padding: 55px 7%;
    }

    #{{ section_id }} .material-builder__heading {
      margin-bottom: 30px;
    }

    #{{ section_id }} .material-builder__description {
      font-size: 16px;
      line-height: 1.7;
    }

  }


  /* --------------------------------
     MOBILE
  -------------------------------- */

  @media screen and (max-width: 749px) {

    #{{ section_id }} .material-builder__tabs-wrapper {
      overflow-x: auto;
      padding: 0;
      scrollbar-width: none;
    }

    #{{ section_id }} .material-builder__tabs-wrapper::-webkit-scrollbar {
      display: none;
    }

    #{{ section_id }} .material-builder__tabs {
      width: max-content;
      min-width: 100%;
      justify-content: flex-start;
    }

    #{{ section_id }} .material-builder__tab {
      flex: 0 0 auto;

      padding: 20px 22px;

      font-size: 12px;
      white-space: nowrap;
    }

    #{{ section_id }} .material-builder__panel {
      grid-template-columns: 1fr;
    }

    #{{ section_id }} .material-builder__panel.is-active {
      display: flex;
      flex-direction: column;
    }

    #{{ section_id }} .material-builder__image-wrapper {
      order: 1;

      min-height: 350px;
      height: 350px;
    }

    #{{ section_id }} .material-builder__text {
      order: 2;

      padding: 50px 25px 60px;
    }

    #{{ section_id }} .material-builder__heading {
      margin-bottom: 25px;

      font-size: 32px;
    }

    #{{ section_id }} .material-builder__description {
      font-size: 16px;
      line-height: 1.7;
    }

    #{{ section_id }} .material-builder__button {
      margin-top: 28px;

      width: 100%;
    }

  }
</style>

<script src="{{ 'material-builder.js' | asset_url }}" type="module"></script>

{% schema %}
{
  "name": "Material Builder",
  "tag": "section",
  "class": "section-material-builder",

  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#171717"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Active tab color",
      "default": "#ffffff"
    }
  ],

  "blocks": [
    {
      "type": "material",
      "name": "Material tab",

      "settings": [
        {
          "type": "text",
          "id": "tab_title",
          "label": "Tab title",
          "default": "TOP & BOTTOM MATERIAL"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Top & Bottom Material"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Your custom leather motorcycle jacket starts with the leather you pick for yourself. We offer full-grain cowhide, drum-dyed hides, buffalo leather, canvas, mesh, denim, and twill. Want something bolder? Go with snake, dragon, or croc-textured leather. Our custom builder lets you mix materials for top and bottom, preview combinations in real-time, and create a personalized biker vest or jacket that looks exactly how you imagined.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "START BUILDING NOW"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "Material Builder",

      "blocks": [
        {
          "type": "material",
          "settings": {
            "tab_title": "TOP & BOTTOM MATERIAL",
            "heading": "Top & Bottom Material"
          }
        },
        {
          "type": "material",
          "settings": {
            "tab_title": "STITCH COLORS",
            "heading": "Stitch Colors"
          }
        },
        {
          "type": "material",
          "settings": {
            "tab_title": "QUILTED TEXTURE",
            "heading": "Quilted Texture"
          }
        },
        {
          "type": "material",
          "settings": {
            "tab_title": "ACCENTS",
            "heading": "Accents"
          }
        },
        {
          "type": "material",
          "settings": {
            "tab_title": "INSIDE LINER",
            "heading": "Inside Liner"
          }
        }
      ]
    }
  ]
}
{% endschema %}
